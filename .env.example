# ─────────────────────────────────────────────────────────────────────────────
# ReadTrack — environment variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API

# Your project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon / public" key — safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role / secret" key — NEVER expose this to the browser.
# Used only in server-side API routes to bypass storage RLS for file uploads.
SUPABASE_SERVICE_ROLE_KEY=
